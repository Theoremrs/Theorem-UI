{
  "name": "workbench-palette",
  "version": "1.0",
  "description": "AC-28 (coordinated palette) and the theme half of AC-27 for the Theo workbench, evaluated per surface per palette profile from rendered observations of the live story. Each check names the surfaces that draw its role; a surface that does not draw a role is not scored on it.",
  "profiles": {
    "mapping": "Neutral = github-sharp, Paper = stone, Forest = vitesse (the app's PALETTES); every palette in light and dark. Slate has no profile of its own: the terminal's slate is github-sharp's cool tint."
  },
  "fixed_roles": {
    "success": "Terminal ANSI green and the added marker are GitHub Dark's token colour (terminal-roles.ts, githubDarkTheme), kept so test output reads as a terminal does.",
    "link": "GitHub Dark's link blue, kept as the mention colour in every profile.",
    "warning": "pi slate's gold (terminal-theme.ts SLATE.gold), held at its slate hue and shifted only as far as readability on the profile's surfaces requires (status()).",
    "error": "pi slate's error red (SLATE.error), same rule as warning.",
    "accent": "pi slate's sage (SLATE.sage), the focus and active-tab colour, same rule as warning.",
    "syntax": "The syntax roles are githubDarkTheme.tokens constants (terminal-roles.ts); the diff hues are GitHub Dark's red and green hues placed at a lightness that follows the profile's background."
  },
  "classes": {
    "standard": "a published threshold the interface must meet",
    "contract": "a statement about the build that must hold",
    "target": "a goal; a miss is review, not a failure",
    "diagnostic": "reported with its number, never a verdict"
  },
