tart(2, '0')})`;\n  },\n};\n"},"fidelity":[{"id":"overview","rank":0,"label":"Overview","assumptions":["Each step is one phase; the adder settles at once."]}],"initialFidelity":"overview","components":[{"atomId":"a","role":"register","tier":"overview","ports":[{"id":"q","direction":"out","width":2}]},{"atomId":"b","role":"register","tier":"overview","ports":[{"id":"q","direction":"out","width":2}]},{"atomId":"adder","role":"alu","tier":"overview","ports":[{"id":"a","direction":"in","width":2},{"id":"b","direction":"in","width":2},{"id":"sum","direction":"out","width":2}]},{"atomId":"out","role":"register","tier":"overview","ports":[{"id":"d","direction":"in","width":2}]}],"connections":[{"relationId":"a-adder","from":{"atomId":"a","port":"q"},"to":{"atomId":"adder","port":"a"},"width":2,"kind":"data","tier":"overview"},{"relationId":"b-adder","from":{"atomId":"b","port":"q"},"to":{"atomId":"adder","port":"b"},"width":2,"kind":"data","tier":"overview"},{"relationId":"adder-out","from":{"atomId":"adder","port":"sum"},"to":{"atomId":"out","port":"d"},"width":2,"kind":"data","tier":"overview"}],"state":[{"id":"a","owner":"a","width":2,"initial":1,"label":"a"},{"id":"b","owner":"b","width":2,"initial":2,"label":"b"},{"id":"out","owner":"out","width":2,"initial":0,"label":"out"}],"inputs":[{"id":"a","label":"a","state":"a"},{"id":"b","label":"b","state":"b"}],"operations":[{"id":"step","label":"Step","kind":"step"},{"id":"reset","label":"Reset","kind":"reset"}],"events":[{"id":"read","label":"Read operands","touches":["a","b","a-adder","b-adder"]},{"id":"add","label":"Add","touches":["adder"]},{"id":"write","label":"Write result","touches":["adder-out","out"],"writes":["out"]}],"checks":[{"id":"one-plus-two","label":"1 + 2 = 3","given":[{"invoke":"operation","operation":"step"},{"invoke":"operation","operation":"step"},{"invoke":"operation","operation":"step"}],"expect":{"out":3},"expectEvents":["read","add","write"]},{"id":"wraps","label":"3 + 1 wraps to 0 in two bits","given":[{"invoke":"write","input":"a","value":3},{"invoke":"write","input":"b","value":1},{"invoke":"operation","operation":"step"},{"invoke":"operation","operation":"step"},{"invoke":"operation","operation":"step"}],"expect":{"out":0}}],"presentation":[{"id":"intro","directives":[{"directive":"focus","targets":["a","b"]},{"directive":"explain","target":"adder","text":"Two two-bit registers hold a = {a} and b = {b}. Step to watch the adder add them."}]},{"id":"read","directives":[{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"focus","targets":["a","b","a-adder","b-adder"]},{"directive":"explain","target":"adder","text":"Read: {a.q} and {b.q} travel to the adder."}]},{"id":"add","directives":[{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"focus","targets":["adder"]},{"directive":"explain","target":"adder","text":"Add: the adder's sum is {adder.sum}."}]},{"id":"write","directives":[{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"focus","targets":["adder-out","out"]},{"directive":"explain","target":"out","text":"Write: out now holds {out}."}]},{"id":"wrap","prompt":"What happens at 3 + 1?","directives":[{"directive":"invoke","invocation":{"invoke":"write","input":"a","value":3}},{"directive":"invoke","invocation":{"invoke":"write","input":"b","value":1}},{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"invoke","invocation":{"invoke":"operation","operation":"step"}},{"directive":"focus","targets":["adder","out"]},{"directive":"explain","target":"out","text":"3 + 1 is 4, which needs three bits. Two bits keep only the low ones, so out holds {out}."}]}],"assumptions":["A real adder takes time for its carries to settle; this one finishes within a step."]},"provenance":{"compileTrace":{"chromeSelect":{"chrome_id":"explanation_shell","fallbacks":[],"rationale":"goal=explain-process; projection=explanation_cells; preferred_affordances=[\"player\", \"narration\"]; finalist_affordances=[\"narration\", \"node-detail\", \"step-controls\", \"operand-editor\", \"fidelity-switcher\", \"follow-up\"]"},"goal":{"confidence":0.75,"fallbacks":["summarize","inspect-evidence"],"goal":"explain-process","rationale":"keyword:how does"},"projectionSelect":{"fallbacks":["patent_diagram","tree_hierarchy","numeric_series","categorical_set","flow_layered","sankey_flow"],"projection_id":"explanation_cells","rationale":"answer_type=explanation_cells; explicit projection hint"},"selectedGoal":"explain-process","selectedShape":"dag","shape":{"confidence":0.7,"fallbacks":["tree","categorical-set"],"rationale":"dag:3-edges","required_fields":["kind"],"shape":"dag"}},"director":"scene-os-core","generator":{"id":"scene-os-core.generate_datapath","model":"two-bit-adder"},"summary":"Two registers feed an adder, and the sum is written into a third register. Two bits hold 0 to 3, so 3 + 1 wraps to 0.","title":"How a two-bit adder adds"}}